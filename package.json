{
  "name": "tiladys-platform",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,CONTROL -c auto npm:dev:web npm:dev:control",
    "dev:web": "npm --workspace @tiladys/web run dev",
    "dev:control": "npm --workspace @tiladys/control run dev",
    "build": "npm run db:generate && npm run build:control && npm run build:web",
    "build:web": "npm --workspace @tiladys/web run build",
    "build:control": "npm --workspace @tiladys/control run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node tests/project.test.mjs && node --experimental-strip-types --test tests/contact-security.test.ts tests/contact-images.test.ts tests/public-safety.test.ts && node --import tsx --test tests/portfolio-seo.test.ts && TSX_TSCONFIG_PATH=apps/control/tsconfig.json node --import tsx --test tests/portfolio-public-routes.test.ts && node --import tsx --test tests/crm-service-jobs.test.ts",
    "db:generate": "npm --workspace @tiladys/db run generate",
    "db:migrate": "npm --workspace @tiladys/db run migrate",
    "db:seed": "npm --workspace @tiladys/db run seed",
    "setup:admin": "node scripts/setup-admin.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:deploy": "npm --workspace @tiladys/db run deploy",
    "test:browser": "node tests/phase1-browser.mjs",
    "test:db:phase1": "node --import tsx --test tests/phase1-database.test.ts",
    "test:db:crm": "node --import tsx --test tests/crm-service-jobs.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
