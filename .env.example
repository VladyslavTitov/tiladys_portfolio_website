# Local template only. Never commit populated env files or share secrets in chat.
# Vercel: configure projects separately; isolate Production from Preview.
# Full inventory and release process: docs/production-recovery.md.

# BOTH apps: server-only runtime connection. Production must use the same
# canonical database/schema; runtime roles may differ.
DATABASE_URL=""
# DEVELOPMENT ONLY: separate disposable shadow database, never Production.
# Prisma migrate deploy does not need a shadow database.
SHADOW_DATABASE_URL=""

# WEB: unique Secret; required in production-mode runtime, including Preview.
# Operator generates privately with: openssl rand -hex 32
CONTACT_RATE_LIMIT_SECRET=""
# WEB on Vercel: trusted ingress header. Direct local requests may use unknown.
CONTACT_IP_HEADER="x-vercel-forwarded-for"
# WEB: owner must explicitly decide whether private images should be enabled.
CONTACT_UPLOADS_ENABLED="false"
# WEB: server-only API origin; Production must use verified Control origin.
CONTROL_API_URL="http://localhost:3001"
# WEB: intentionally public; Production uses https://tiladys.com.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NEXT_PUBLIC_CONTROL_API_URL is a legacy fallback; prefer CONTROL_API_URL.
# Browser JS does not require it. Control media URLs/CSP may expose its origin.
# Origins must never contain credentials or tokens.

# CONTROL: unique Secret for IP hashing, distinct from contact secret.
AUTH_SECRET=""
# CONTROL: exact canonical admin origin, without path/query/credentials.
CONTROL_URL="http://localhost:3001"
# Optional additional exact admin origins, separated by commas. No wildcards.
CONTROL_ALLOWED_ORIGINS=""
# CONTROL: public API CORS origin, still used by proxy.ts.
SITE_URL="http://localhost:3000"
# CONTROL: required for replies/login alerts; password/user are private.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Optional private alert recipient; default is the authenticated admin's email.
ADMIN_ALERT_EMAIL=""

# Local schema-verification opt-in. Vercel always verifies regardless of this.
# RELEASE_SCHEMA_CHECK="1"
# REDIS_URL is obsolete: contact counters use PostgreSQL.
