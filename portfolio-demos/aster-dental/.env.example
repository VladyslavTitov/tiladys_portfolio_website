# Node 22.13+ required. Local file persistence; not suitable for ephemeral serverless disks.
SITE_URL=http://localhost:3000
DEMO_MODE=true
DATABASE_PATH=./data/demo.sqlite
# Run npm run admin:setup to create ADMIN_PASSWORD_HASH in .env.local.
# Never commit real environment files or database contents.
# For Vercel, use a dedicated Neon database:
# DATABASE_URL=postgresql://...
