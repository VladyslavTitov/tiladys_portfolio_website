// Local bounded security checks. No exploit scanning, no account brute force.
import assert from 'node:assert/strict';import test from 'node:test';import {readFile,writeFile} from 'node:fs/promises';import crypto from 'node:crypto';import sharp from 'sharp';
import {PrismaClient} from '@prisma/client';import {prepareContactImages} from '../apps/web/lib/contact-images';import {safeExternalUrl,taskSchema} from '../apps/control/lib/rebuild-domain';import {invoiceLineSchema} from '@tiladys/shared';import {csvCell} from '../apps/control/lib/csv';
const url=new URL(process.env.DATABASE_URL||'http://missing');assert.equal(url.hostname,'127.0.0.1');assert.equal(url.port,'55432');assert.equal(url.pathname,'/tiladys_rebuild_test');
const db=new PrismaClient(),checks:string[]=[];test.after(async()=>{await db.$disconnect();await writeFile('docs/qa/evidence/security-regressions.json',JSON.stringify({checks},null,2));});
test('SEC-UPLOAD-01 rejects executable SVG and MIME/signature mismatch',async()=>{for(const type of ['image/svg+xml','image/png'])await assert.rejects(()=>prepareContactImages([new File(['<svg onload="alert(1)"></svg>'],'qa.svg',{type})]));const png=await sharp({create:{width:2,height:2,channels:3,background:'white'}}).png().toBuffer();await assert.rejects(()=>prepareContactImages([new File([png],'qa.jpg',{type:'image/jpeg'})]));checks.push('SEC-UPLOAD-01');});
test('SEC-UPLOAD-02 traversal filename is replaced, originals/metadata discarded',async()=>{const png=await sharp({create:{width:2,height:2,channels:3,background:'white'}}).png().toBuffer();const [r]=await prepareContactImages([new File([png],'../../qa-private.png',{type:'image/png'})]);assert.equal(r.filename,'inquiry-image-1.webp');assert.equal(r.mimeType,'image/webp');assert.equal((await sharp(r.data).metadata()).exif,undefined);checks.push('SEC-UPLOAD-02');});
test('SEC-INPUT-01 executable URLs and bounded financial/task inputs reject',()=>{for(const value of ['javascript:alert(1)','data:text/html,qa','http://example.test','https://127.0.0.1','https://10.0.0.1','https://[::1]','https://user:pass@example.test'])assert.throws(()=>safeExternalUrl(value));const line={serviceName:'QA',serviceNameDe:'QA',unit:'item',unitDe:'Stück',quantity:'1',unitPrice:'1',taxTreatment:'ZERO_RATED',priceConfirmed:true};for(const amount of ['-1','NaN','Infinity','1e999','999999999999999999999'])assert.equal(invoiceLineSchema.safeParse({...line,unitPrice:amount}).success,false,`Invalid boundary amount: ${amount}`);assert.equal(taskSchema.safeParse({title:'QA',status:'TODO',priority:Infinity,dueAt:null,customerId:null,serviceJobId:null}).success,false);assert.equal(csvCell('=HYPERLINK("https://example.test")').startsWith('"\''),true);checks.push('SEC-INPUT-01');});
test('SEC-SSRF-01 optimizer rejects unallowlisted remote/private URL before fetch',async()=>{for(const target of ['http://127.0.0.1:1/qa','http://169.254.169.254/latest/meta-data/','https://untrusted.example.test/qa.png']){const res=await fetch('http://127.0.0.1:3100/_next/image?'+new URLSearchParams({url:target,w:'640',q:'75'}));assert.equal(res.status,400);}checks.push('SEC-SSRF-01');});
test('SEC-CONTACT-01 same concurrent idempotency key yields one stored enquiry',async()=>{const key=crypto.randomUUID(),email=`qa-replay-${crypto.randomUUID()}@example.test`,body={name:'QA exact replay',email,message:'Literal <img src=x onerror=alert(1)> 🙂\nSELECT * FROM "Customer";',consent:true,locale:'fr',replyLanguage:'uk'};const send=(data:unknown)=>fetch('http://127.0.0.1:3100/api/contact',{method:'POST',headers:{origin:'http://127.0.0.1:3100','Content-Type':'application/json','Idempotency-Key':key},body:JSON.stringify(data)});const results=await Promise.all([send(body),send(body)]);assert.ok(results.every(r=>r.status===201));const refs=await Promise.all(results.map(r=>r.json()));assert.equal(refs[0].reference,refs[1].reference);assert.equal(await db.contactMessage.count({where:{email}}),1);const row=await db.contactMessage.findFirstOrThrow({where:{email}});assert.equal(row.message,body.message);assert.equal(row.replyLanguage,'uk');assert.equal((await send({...body,message:'changed same key'})).status,409);checks.push('SEC-CONTACT-01');});
test('SEC-AUTH-01 bounded invalid attempts cannot evade shared IP throttle using forged forwarding',async()=>{const statuses=[];for(let i=0;i<13;i++){const r=await fetch('http://127.0.0.1:3101/api/auth/login',{method:'POST',headers:{origin:'http://127.0.0.1:3101','Content-Type':'application/json','x-forwarded-for':`198.51.100.${i+1}`},body:JSON.stringify({email:`qa-missing-${crypto.randomUUID()}@example.test`,password:'QA invalid',secretWord:'QA invalid'})});statuses.push(r.status);}assert.ok(statuses.every(s=>[401,429].includes(s)));assert.equal(statuses.at(-1),429);checks.push('SEC-AUTH-01');});
