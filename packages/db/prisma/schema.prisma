generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
  SPAM
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomerType {
  PERSON
  BUSINESS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ServiceJobStatus {
  PLANNED
  IN_PROGRESS
  WAITING_CUSTOMER
  COMPLETED
  CANCELLED
}

enum FileAssetKind {
  BEFORE
  DURING
  AFTER
  DOCUMENT
  OTHER
}

enum FileAssetVisibility {
  PRIVATE
}

enum JobLineTaxTreatment {
  UNCONFIRMED
  VAT_STANDARD
  VAT_REDUCED
  ZERO_RATED
  EXEMPT
  KLEINUNTERNEHMER
}

enum CataloguePriceMode {
  FIXED
  FROM
  HOURLY
  MONTHLY
  PERCENTAGE
  MANUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BusinessTaxMode {
  UNCONFIRMED
  VAT
  KLEINUNTERNEHMER
  EXEMPT
}

model AdminUser {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  secretWordHash String
  displayName    String     @default("Administrator")
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  audits         AuditLog[]
  customerNotes  CustomerNote[]
  customerActivities CustomerActivity[]
  uploadedFiles  FileAsset[]
  invoicePayments InvoicePayment[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  category     String
  status       ProjectStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  title        Json
  summary      Json
  description  Json?
  type         Json?
  role         Json?
  workItems    Json?
  clientName   String?
  projectDate  DateTime?
  websiteUrl   String?
  githubUrl    String?
  coverImage   String?
  gallery      Json?
  technologies Json?
  results      Json?
  seoTitle     Json?
  seoDescription Json?
  socialTitle  Json?
  socialDescription Json?
  socialImageId String?
  socialImage  ProjectImage? @relation("SocialPreview", fields: [socialImageId], references: [id], onDelete: SetNull)
  slugAliases  ProjectSlugAlias[]
  images       ProjectImage[] @relation("ProjectImages")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, category, sortOrder])
}


model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  socialFor Project[] @relation("SocialPreview")
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  alt       Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model PriceSection {
  id        String      @id @default(cuid())
  number    String
  title     Json
  subtitle  Json?
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  items     PriceItem[]
}

model PriceItem {
  id        String       @id @default(cuid())
  sectionId String
  section   PriceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  code      String       @unique
  name      Json
  price     String
  note      Json?
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  serviceJobs ServiceJob[]
  jobLineItems ServiceJobLineItem[]

  @@index([sectionId, active, sortOrder])
}

model NumberSequence {
  scope     String
  year      Int
  nextValue Int @default(1)

  @@id([scope, year])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  street      String?
  postalCode  String?
  city        String?
  country     String   @default("DE")
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customers   Customer[]
  serviceJobs ServiceJob[]

  @@index([name])
}

model Customer {
  id                String         @id @default(cuid())
  customerNumber    String         @unique
  type              CustomerType   @default(PERSON)
  status            CustomerStatus @default(LEAD)
  firstName         String?
  lastName          String?
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email             String?
  phone             String?
  secondaryPhone    String?
  street            String?
  postalCode        String?
  city              String?
  country           String         @default("DE")
  preferredLanguage String         @default("de")
  source            String?
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  customerNotes     CustomerNote[]
  activities        CustomerActivity[]
  serviceJobs       ServiceJob[]
  files             FileAsset[]
  invoices          Invoice[]

  @@index([status, updatedAt])
  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
}

model CustomerNote {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body        String
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([customerId, createdAt])
}

model CustomerActivity {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  summary     String
  metadata    Json?
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([customerId, createdAt])
}

model ServiceJob {
  id                   String           @id @default(cuid())
  jobNumber            String           @unique
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  companyId            String?
  company              Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  servicePriceItemId   String?
  servicePriceItem     PriceItem?        @relation(fields: [servicePriceItemId], references: [id], onDelete: SetNull)
  serviceType          String?
  title                String
  description          String?
  privateNotes         String?
  customerVisibleNotes String?
  serviceDate          DateTime?
  status               ServiceJobStatus @default(PLANNED)
  estimatedPrice       Decimal?         @db.Decimal(12, 2)
  finalPrice           Decimal?         @db.Decimal(12, 2)
  materialCost         Decimal?         @db.Decimal(12, 2)
  otherCost            Decimal?         @db.Decimal(12, 2)
  startTime            DateTime?
  endTime              DateTime?
  workDurationMinutes  Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  files                FileAsset[]
  lineItems            ServiceJobLineItem[]
  invoices             Invoice[]

  @@index([customerId, status, serviceDate])
  @@index([companyId])
  @@index([status, serviceDate])
}

model BusinessBillingSettings {
  id                 String          @id @default("default")
  legalName          String          @default("TiLADYS – Vladyslav Titov")
  street             String          @default("Kronenstraße 19")
  postalCode         String          @default("45479")
  city               String          @default("Mülheim an der Ruhr")
  country            String          @default("Germany")
  email              String          @default("contact@tiladys.com")
  phone              String          @default("+49 163 7235608")
  taxMode            BusinessTaxMode @default(UNCONFIRMED)
  taxNumber          String?
  vatId              String?
  taxStatement       String?
  bankAccountHolder  String?
  iban               String?
  bic                String?
  bankName           String?
  paymentTermsDays   Int?
  paymentInstructions String?
  settingsConfirmedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Invoice {
  id                    String        @id @default(cuid())
  invoiceNumber         String?       @unique
  status                InvoiceStatus @default(DRAFT)
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceJobId          String?
  serviceJob            ServiceJob?   @relation(fields: [serviceJobId], references: [id], onDelete: SetNull)
  currency              String        @default("EUR")
  issueDate             DateTime?
  dueDate               DateTime?
  serviceDateFrom       DateTime?
  serviceDateTo         DateTime?
  sellerLegalName       String
  sellerStreet          String
  sellerPostalCode      String
  sellerCity            String
  sellerCountry         String
  sellerEmail           String
  sellerPhone           String
  sellerTaxMode         BusinessTaxMode
  sellerTaxNumber       String?
  sellerVatId           String?
  sellerTaxStatement    String?
  sellerBankAccountHolder String?
  sellerIban            String?
  sellerBic             String?
  sellerBankName        String?
  paymentTermsDays      Int?
  paymentInstructions   String?
  recipientName         String
  recipientCompany      String?
  recipientEmail        String?
  recipientStreet       String
  recipientPostalCode   String
  recipientCity         String
  recipientCountry      String
  customerReference     String?
  notes                 String?
  subtotal              Decimal       @db.Decimal(14, 2)
  taxTotal              Decimal?      @db.Decimal(14, 2)
  total                 Decimal       @db.Decimal(14, 2)
  issuedPdf              Bytes?
  issuedPdfChecksum      String?
  issuedPdfSize          Int?
  issuedAt               DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  lines                  InvoiceLine[]
  payments               InvoicePayment[]

  @@index([customerId, createdAt])
  @@index([serviceJobId])
  @@index([status, issueDate])
}

model InvoiceLine {
  id             String              @id @default(cuid())
  invoiceId      String
  invoice        Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName    String
  description    String?
  quantity       Decimal             @db.Decimal(12, 3)
  unit           String
  unitPrice      Decimal             @db.Decimal(12, 2)
  taxTreatment   JobLineTaxTreatment
  taxRate        Decimal?            @db.Decimal(5, 2)
  subtotal       Decimal             @db.Decimal(14, 2)
  taxAmount      Decimal?            @db.Decimal(14, 2)
  total          Decimal             @db.Decimal(14, 2)
  sortOrder      Int                 @default(0)

  @@index([invoiceId, sortOrder])
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime
  method      String?
  reference   String?
  note        String?
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([invoiceId, paidAt])
}

model ServiceJobLineItem {
  id                   String                 @id @default(cuid())
  serviceJobId         String
  serviceJob           ServiceJob             @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  cataloguePriceItemId String?
  cataloguePriceItem   PriceItem?             @relation(fields: [cataloguePriceItemId], references: [id], onDelete: SetNull)
  serviceName          String
  description          String?
  quantity             Decimal                @db.Decimal(12, 3)
  unit                 String
  cataloguePriceText   String?
  catalogueUnitPrice   Decimal?               @db.Decimal(12, 2)
  cataloguePriceMode   CataloguePriceMode     @default(MANUAL)
  priceConfirmed       Boolean                @default(false)
  agreedUnitPrice      Decimal                @db.Decimal(12, 2)
  taxTreatment         JobLineTaxTreatment    @default(UNCONFIRMED)
  taxRate              Decimal?               @db.Decimal(5, 2)
  subtotal             Decimal                @db.Decimal(14, 2)
  taxAmount            Decimal?               @db.Decimal(14, 2)
  total                Decimal                @db.Decimal(14, 2)
  internalUnitCost     Decimal?               @db.Decimal(12, 2)
  sortOrder            Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([serviceJobId, sortOrder])
  @@index([cataloguePriceItemId])
}

model FileAsset {
  id               String              @id @default(cuid())
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceJobId     String?
  serviceJob       ServiceJob?         @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  kind             FileAssetKind       @default(DOCUMENT)
  visibility       FileAssetVisibility @default(PRIVATE)
  filename         String
  originalFilename String
  mimeType         String
  size             Int
  storageProvider  String
  storageKey       String              @unique
  checksum         String
  caption          String?
  sortOrder        Int                 @default(0)
  uploadedById     String
  uploadedBy       AdminUser           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now())

  @@index([customerId, createdAt])
  @@index([serviceJobId, sortOrder])
}

model ContactMessage {
  attachments ContactAttachment[]
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  locale    String        @default("en")
  message   String
  status    MessageStatus @default(UNREAD)
  replyText String?
  repliedAt DateTime?
  consent   Boolean       @default(false)
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model VisitorDay {
  id        String   @id @default(cuid())
  day       DateTime @unique
  sessions  Int      @default(0)
  pageViews Int      @default(0)
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  ipHash    String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([createdAt, action])
}

model ContactAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([messageId])
}

model ContactRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// Old slugs resolve directly to the current project, never through redirect chains.
model ProjectSlugAlias {
  slug String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}
