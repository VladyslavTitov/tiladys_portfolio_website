import argon2 from 'argon2';
import {PrismaClient} from '@tiladys/db';import crypto from 'node:crypto';import {writeFile,mkdir} from 'node:fs/promises';import sharp from 'sharp';
const url=new URL(process.env.DATABASE_URL||'http://missing');if(url.hostname!=='127.0.0.1'||url.port!=='55432'||url.pathname!=='/tiladys_rebuild_test')throw Error('ISOLATED_SYNTHETIC_DATABASE_REQUIRED');const db=new PrismaClient();const password=crypto.randomBytes(32).toString('hex'),secretWord=crypto.randomBytes(32).toString('hex');const user=await db.adminUser.create({data:{email:`browser-${crypto.randomUUID()}@example.test`,passwordHash:await argon2.hash(password),secretWordHash:await argon2.hash(secretWord),displayName:'Synthetic owner'}});const token=crypto.randomBytes(48).toString('base64url');await db.session.create({data:{userId:user.id,tokenHash:crypto.createHash('sha256').update(token).digest('hex'),expiresAt:new Date(Date.now()+3600000)}});const publishedMedia=process.argv.includes('--published-media');const translations=(text:string)=>Object.fromEntries(['en','de','uk','ru','sk','fr'].map(l=>[l,`${l.toUpperCase()} · ${text}`]));const data=await sharp({create:{width:720,height:480,channels:3,background:'#7be0df'}}).webp().toBuffer();
