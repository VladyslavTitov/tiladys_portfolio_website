const product=await db.product.upsert({where:{slug:'synthetic-template'},create:{slug:'synthetic-template',type:'FRAMER_TEMPLATE',status:publishedMedia?'PUBLISHED':'DRAFT',title:translations('Synthetic template'),description:translations('Synthetic QA product, not an actual offer'),included:translations('Synthetic included files'),license:translations('Synthetic test license'),rightsConfirmed:true,available:false,images:{create:{filename:'synthetic.webp',mimeType:'image/webp',size:data.length,data,alt:translations('Synthetic test preview')}}},update:{status:publishedMedia?'PUBLISHED':'DRAFT'}});
const privateProduct=await db.product.upsert({where:{slug:'synthetic-draft'},create:{slug:'synthetic-draft',type:'MODEL_3D',title:{en:'Synthetic private model'},description:{},included:{},license:{},images:{create:{filename:'synthetic.webp',mimeType:'image/webp',size:data.length,data,alt:{}}}},update:{}});const image=await db.productImage.findFirstOrThrow({where:{productId:privateProduct.id}});await mkdir('/tmp/tiladys-rebuild',{recursive:true});await writeFile('/tmp/tiladys-rebuild/browser-fixtures.json',JSON.stringify({token,password,secretWord,email:user.email,userId:user.id,privateProductImage:image.id,publicProductId:product.id}),{mode:0o600});console.log(publishedMedia?'Synthetic browser fixtures prepared with explicit test-only public media; no SMTP used.':'Synthetic browser fixtures prepared privately; publication disabled by default; no SMTP used.');await db.$disconnect();
